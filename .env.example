APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
# redis is required in production — file driver is per-container and loses
# cache/session on every deploy; Redis is shared across all app instances.
CACHE_DRIVER=redis
# local is for dev only — use 'gcs' in production so uploads land on Google Cloud
# Storage (shared across all app instances); local disk is ephemeral per container.
FILESYSTEM_DISK=local
# sync is for local dev only — use redis (or database) in production,
# otherwise queued jobs (notifications, exports) run inline in the request.
QUEUE_CONNECTION=sync
# redis is required in production — file sessions are ephemeral per container
# and break sticky-session / horizontal scaling.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# The Laravel scheduler (backup:run, maintenance:run, queue:monitor, etc. —
# see app/Console/Kernel.php) is a no-op unless this is true. Production's
# supervisor already runs `artisan schedule:work`, but that process just
# idles forever if ENABLE_SCHEDULER stays false — set true in production.
ENABLE_SCHEDULER=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google Cloud Storage (config/filesystems.php — disk 'gcs').
# Set FILESYSTEM_DISK=gcs in production to route uploads through GCS.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_KEY_FILE=
GOOGLE_CLOUD_STORAGE_BUCKET=
# Optional: path prefix inside the bucket (default '' = root).
GOOGLE_CLOUD_STORAGE_PATH_PREFIX=
# Optional: override the default GCS API URI.
GOOGLE_CLOUD_STORAGE_API_URI=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Anthropic API key for AI suggestions (Lead conversion, DesignItem description).
# Leave unset to disable AI features — AiAssistService fails closed (returns null).
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# Sentry error tracking (app/Exceptions/Handler.php). Leave SENTRY_LARAVEL_DSN
# unset to disable — reporting becomes a safe no-op, nothing else changes.
# Set in production to a real DSN from your Sentry project settings.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
# Fraction of requests to sample for performance tracing (0.0-1.0). Keep low
# in production to control Sentry quota usage; unset disables tracing.
SENTRY_TRACES_SAMPLE_RATE=0.1
