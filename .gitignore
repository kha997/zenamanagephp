/storage/backups/
# runtime contents of storage/framework are ignored via per-directory
# .gitignore placeholders; the directory STRUCTURE must stay tracked —
# a fresh checkout without storage/framework/cache/data makes
# `php artisan cache:clear` exit 1 (this broke the Routes Guardrails CI
# check on every branch from 2025-12 until 2026-07-14).

# block accidental machine-local folders
Users/

# macOS noise
.DS_Store

# runtime / generated — contents ignored by per-directory .gitignore files

# local backups (must never be committed)
storage/backups/

# local ssl material (private keys must never be committed)
storage/ssl/

# env files (keep only *.example in repo)
.env
.env.*
production.env

# Local backups
*.bak.*

